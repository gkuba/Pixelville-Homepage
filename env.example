# Copy to .env (Dockge: the .env box under the compose). Never commit the real .env.

# Homepage host check: the host:port you open the dashboard on
HOMEPAGE_ALLOWED_HOSTS=

# Network values used by compose.yaml
DNS_SERVER=
DNS_SEARCH_DOMAIN=
IP_PIXELGATE=
IP_PIXELAI=
IP_PIXELSTORE=
IP_PIXEL=
IP_PIXEL2=
IP_PIXEL3=

# Values used by config/services.yaml
HOMEPAGE_VAR_MODEM_HOST=
HOMEPAGE_VAR_TPLINK_PATH=

# Credentials and API keys
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_ADGUARD_STORE_USER=
HOMEPAGE_VAR_ADGUARD_STORE_PASS=
HOMEPAGE_VAR_ADGUARD_UTIL_USER=
HOMEPAGE_VAR_ADGUARD_UTIL_PASS=
HOMEPAGE_VAR_DELUGE_PASS=
